# Usa el SHA publicado por el flujo de entrega continua (etiqueta inmutable).
APP_VERSION=REEMPLAZA_POR_SHA_PUBLICADO
DJANGO_SECRET_KEY=genera-una-clave-aleatoria-larga
DJANGO_ALLOWED_HOSTS=staging.ejemplo.edu.ec
CORS_ALLOWED_ORIGINS=https://staging.ejemplo.edu.ec
POSTGRES_DB=cibersegura
POSTGRES_USER=cibersegura
POSTGRES_PASSWORD=usa-un-secreto-exclusivo
DEMO_USER_PASSWORD=define-una-clave-de-pruebas
DEMO_ADMIN_PASSWORD=define-una-clave-administrativa
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=CiberSegura <no-reply@ejemplo.edu.ec>
